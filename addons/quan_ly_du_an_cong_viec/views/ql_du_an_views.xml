<odoo>
    <record id="view_ql_du_an_tree" model="ir.ui.view">
        <field name="name">ql_du_an.tree</field>
        <field name="model">ql_du_an</field>
        <field name="arch" type="xml">
            <tree string="Dự án">
                <field name="ma_du_an"/>
                <field name="ten_du_an"/>
                <field name="quan_ly_id"/>
                <field name="ngay_bat_dau"/>
                <field name="ngay_ket_thuc"/>
                <field name="trang_thai"/>
                <field name="so_cong_viec"/>
                <field name="tien_do"/>
            </tree>
        </field>
    </record>

    <record id="view_ql_du_an_form" model="ir.ui.view">
        <field name="name">ql_du_an.form</field>
        <field name="model">ql_du_an</field>
        <field name="arch" type="xml">
            <form string="Dự án">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_cong_viec"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-tasks">
                            <field name="so_cong_viec" widget="statinfo" string="Công việc"/>
                        </button>
                    </div>

                    <group string="Thông tin dự án">
                        <field name="ma_du_an"/>
                        <field name="ten_du_an"/>
                        <field name="quan_ly_id"/>
                        <field name="thanh_vien_ids" widget="many2many_tags"/>
                        <field name="ngay_bat_dau"/>
                        <field name="ngay_ket_thuc"/>
                        <field name="trang_thai"/>
                        <field name="tien_do" readonly="1"/>
                    </group>

                    <group string="Mục tiêu và mô tả">
                        <field name="muc_tieu"/>
                        <field name="mo_ta"/>
                    </group>

                    <notebook>
                        <page string="Công việc">
                            <field name="cong_viec_ids">
                                <tree editable="bottom">
                                    <field name="ten_cong_viec"/>
                                    <field name="nguoi_phu_trach_id"/>
                                    <field name="deadline"/>
                                    <field name="muc_uu_tien"/>
                                    <field name="trang_thai"/>
                                    <field name="tien_do"/>
                                    <field name="is_qua_han"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ql_du_an" model="ir.actions.act_window">
        <field name="name">Dự án</field>
        <field name="res_model">ql_du_an</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
